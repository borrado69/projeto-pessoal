[Unit]
Description=Obscurity - servidores publicos (3 x 6 vagas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obscurity
WorkingDirectory=/opt/obscurity
ExecStart=/usr/bin/python3 -u /opt/obscurity/servidor_publico.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
